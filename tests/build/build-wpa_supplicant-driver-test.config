# User space test driver (-Dtest) with the full protocol feature set
CONFIG_DRIVER_TEST=y
CONFIG_DRIVER_NONE=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_PSK=y
CONFIG_EAP_PWD=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_IEEE80211R=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211BE=y
CONFIG_WNM=y
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_FILS=y
CONFIG_FILS_SK_PFS=y
CONFIG_SUITEB=y
CONFIG_SUITEB192=y
CONFIG_ERP=y
CONFIG_TESTING_OPTIONS=y
CONFIG_HT_OVERRIDES=y
CONFIG_VHT_OVERRIDES=y
CONFIG_HE_OVERRIDES=y
CONFIG_P2P=y
CONFIG_AP=y
CFLAGS += -Werror
